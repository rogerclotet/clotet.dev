# Set the DSN at build time and runtime. Blank disables error reporting.
NEXT_PUBLIC_GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_ENVIRONMENT=production

# Enable only on the build that produces the deployment artifacts.
GLITCHTIP_UPLOAD_SOURCEMAPS=false
GLITCHTIP_URL=
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=
# Secret: build environment / CI secret only, never NEXT_PUBLIC_*.
GLITCHTIP_AUTH_TOKEN=
# Defaults to VERCEL_GIT_COMMIT_SHA on Vercel; otherwise use the commit SHA.
GLITCHTIP_RELEASE=
